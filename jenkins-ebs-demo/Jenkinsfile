pipeline {
    agent any

    environment {
        // Replace with the EC2 public IPv4 address or public DNS name.
       EC2_HOST = '15.252.236.154'
        APP_DIR = '/opt/ebs-demo'
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Validate files') {
    steps {
        dir('jenkins-ebs-demo') {
            script {
                if (!fileExists('app.py') ||
                    !fileExists('requirements.txt') ||
                    !fileExists('deploy.sh')) {
                    error('Required application files are missing.')
                }

                if (env.EC2_HOST ==
                    'REPLACE_WITH_EC2_PUBLIC_IP') {
                    error('Set the EC2 public IP in Jenkinsfile.')
                }
            }
        }
    }
}

      stage('Deploy to EC2') {
    steps {
        dir('jenkins-ebs-demo') {
            withCredentials([
                sshUserPrivateKey(
                   credentialsId: 'ec2-ssh-key-fixed',
                    keyFileVariable: 'SSH_KEY',
                    usernameVariable: 'SSH_USER'
                )
            ]) {
                bat '''
                    echo Fixing SSH key permissions...
                    icacls "%SSH_KEY%" /inheritance:r
                    icacls "%SSH_KEY%" /grant:r "SYSTEM:R" "Administrators:R"

                    echo Testing SSH connection...
                    ssh -i "%SSH_KEY%" -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=20 ec2-user@15.252.236.154 "mkdir -p /opt/ebs-demo"

                    if errorlevel 1 exit /b 1

                    echo Copying application files...
                    scp -i "%SSH_KEY%" -o StrictHostKeyChecking=accept-new app.py requirements.txt deploy.sh ec2-user@15.252.236.154:/opt/ebs-demo/

                    if errorlevel 1 exit /b 1

                    echo Running deployment script...
                    ssh -i "%SSH_KEY%" -o StrictHostKeyChecking=accept-new ec2-user@15.252.236.154 "chmod +x /opt/ebs-demo/deploy.sh && sudo /opt/ebs-demo/deploy.sh"

                    if errorlevel 1 exit /b 1
                '''
            }
        }
    }
}

        stage('Deployment status') {
            steps {
                echo 'Deployment commands completed. Open http://EC2_HOST:5000 and test saving a note.'
            }
        }
    }

    post {
        success { echo 'EBS demo deployment completed successfully.' }
        failure { echo 'Check Console Output, SSH access, security group, and EBS mount.' }
    }
}
